{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "noEmit": true,
    "jsx": "preserve",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "tests/**/*.ts",
    "tools/**/*.ts",
    "*.ts",
    "apps/web/next-env.d.ts",
    "*.mts"
  ],
  "exclude": ["node_modules", "**/node_modules", "**/.next", "**/dist", "_handoff"]
}
