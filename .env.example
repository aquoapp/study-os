# ---------------------------------------------------------------------------
# STUDY OS · plantilla de entorno
#
# EC-010 · los secretos nunca se versionan ni se escriben en la conversación con
# el agente. Este fichero enseña la FORMA de la configuración; los valores se
# obtienen del panel de Supabase, de Vercel o del gestor de secretos local.
#
# Copia a `.env.local` (ignorado por git) y rellena.
# ---------------------------------------------------------------------------

# --- Público: llega al navegador. Todo lo de aquí es público de facto. --------
# Debe coincidir con PUBLIC_ENV_ALLOWLIST en packages/config.

# local | staging | production
NEXT_PUBLIC_ENVIRONMENT=

# URL del proyecto Supabase. Local por defecto: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=

# Clave anónima (publishable). Está sujeta a RLS: no es un secreto, pero tampoco
# es una autorización. Ver INV-116.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Solo servidor: NUNCA con prefijo NEXT_PUBLIC_ ---------------------------

# Clave de rol de servicio. Atraviesa RLS. Solo en superficies de servidor con
# identidad ya verificada (INV-116). Su aparición en el bundle es un fallo duro
# del Checkpoint Contract.
SUPABASE_SERVICE_ROLE_KEY=

# Cadena de conexión directa a PostgreSQL. La usan `schema-drift` y los tests de
# integración y de RLS. Local por defecto:
#   postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_DB_URL=
